{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Non-secret Databricks identifiers. Committed here so every deploy has them
  // regardless of dashboard state. @astrojs/cloudflare v14 supplies the Worker
  // entrypoint + assets binding automatically — no "main" / "assets" needed.
  "vars": {
    "DATABRICKS_TENANT_ID": "2bec672b-29a0-4df5-ab85-f37e050b36ef",
    "DATABRICKS_CLIENT_ID": "3d662f3a-21b8-4ee5-90e7-7b3f756cf1bc",
    "DATABRICKS_WORKSPACE_URL": "https://adb-353723785162120.0.azuredatabricks.net",
    "DATABRICKS_GENIE_SPACE_ID": "01f10540b4b1184db8db686e85766343",
    "DATABRICKS_GENIE_MODE": "CHAT"
  }

  // Secret — NOT here. Set once with:  npx wrangler secret put DATABRICKS_CLIENT_SECRET
  //   DATABRICKS_CLIENT_SECRET
}
