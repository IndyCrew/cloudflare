---
// "Information at a glance" — a collapsible panel backed by the Databricks
// Genie space via /api/genie. The summary text is the static lede; the chips
// and free-text box run live questions against Genie.
const summary =
  "Bariatric surgery encompasses various surgical procedures aimed at aiding weight loss for individuals suffering from obesity. Common operations include the gastric sleeve, Roux-en-Y gastric bypass, and adjustable gastric banding. These procedures reduce stomach size or alter digestive pathways, leading to significant weight loss. At Community Bariatric Surgeons, specialists employ minimally invasive techniques and provide personalized post-operative care to enhance patient outcomes.";

const suggestions = [
  "What is obesity?",
  "Do you offer non-surgical weight loss?",
  "What is a gastric bypass?",
  "Is there a special diet after bariatric surgery?",
];
---

<section class="iaag" data-iaag>
  <button type="button" class="iaag__bar" data-iaag-toggle aria-expanded="false" aria-controls="iaag-panel">
    <span class="wrap iaag__bar-inner">
      <span class="iaag__title">Information at a glance</span>
      <span class="iaag__toggle">
        <span data-iaag-label>View</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </span>
  </button>

  <div class="iaag__panel" id="iaag-panel" data-iaag-panel hidden>
    <div class="wrap iaag__inner">
      <p class="iaag__summary">{summary}</p>

      <h3 class="iaag__subhead">Have other questions?</h3>
      <div class="iaag__chips">
        {suggestions.map((q) => (
          <button type="button" class="iaag__chip" data-iaag-ask={q}>{q}</button>
        ))}
      </div>

      <form class="iaag__form" data-iaag-form>
        <input
          type="text"
          class="iaag__input"
          name="question"
          placeholder="Ask a question…"
          autocomplete="off"
          maxlength="1000"
        />
        <button type="submit" class="iaag__send">Send</button>
      </form>

      <div class="iaag__answer" data-iaag-answer hidden aria-live="polite"></div>
      <p class="iaag__disclaimer">
        Answers are generated by an AI assistant and may be incomplete. For
        medical advice, contact your care team.
      </p>
    </div>
  </div>
</section>

<style>
  .iaag {
    background: #3f5563;
    color: #fff;
    border-bottom: 3px solid var(--accent);
  }
  .iaag__bar {
    display: block;
    width: 100%;
    background: transparent;
    border: 0;
    color: #fff;
    font: inherit;
    text-align: left;
    cursor: pointer;
    padding: 0;
  }
  .iaag__bar:hover .iaag__toggle { text-decoration: underline; }
  .iaag__bar:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -3px;
  }
  .iaag__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }
  .iaag__title {
    font-family: var(--serif);
    color: #fff;
    font-size: 1.15rem;
    font-weight: 300;
  }
  .iaag__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #fff;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .iaag__toggle svg { transition: transform 0.2s ease; }
  .iaag__bar[aria-expanded="true"] .iaag__toggle svg { transform: rotate(180deg); }

  .iaag__panel {
    background: var(--surface);
    color: var(--ink);
  }
  .iaag__inner { padding-block: 1.75rem 1.5rem; max-width: 760px; }
  .iaag__summary { margin: 0 0 1.25rem; }
  .iaag__subhead {
    font-family: var(--serif);
    color: var(--heading);
    font-size: 1.1rem;
    font-weight: 400;
    margin: 0 0 0.75rem;
  }
  .iaag__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .iaag__chip {
    background: #eef2f4;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--heading);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .iaag__chip:hover:not(:disabled) { background: #e0e8ec; }
  .iaag__chip:disabled { opacity: 0.5; cursor: default; }

  .iaag__form { display: flex; gap: 0.5rem; }
  .iaag__input {
    flex: 1;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 5px;
    font: inherit;
    font-size: 0.95rem;
  }
  .iaag__input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .iaag__send {
    background: var(--accent);
    color: #fff;
    border: 0;
    border-radius: 5px;
    padding: 0.65rem 1.2rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .iaag__send:disabled { opacity: 0.6; cursor: default; }

  .iaag__answer {
    margin-top: 1.25rem;
    padding: 0.4rem 1.1rem;
    background: #f4f7f8;
    border-left: 3px solid var(--accent);
    border-radius: 0 5px 5px 0;
    font-size: 0.97rem;
  }
  .iaag__answer :global(p) { margin: 0.7rem 0; }
  .iaag__answer :global(ul) { margin: 0.7rem 0; padding-left: 1.2rem; }
  .iaag__answer :global(li) { margin: 0.2rem 0; }
  .iaag__answer :global(code) {
    background: #e6ebee;
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    font-size: 0.9em;
    word-break: break-word;
  }
  .iaag__answer[data-state="loading"] { color: var(--muted); font-style: italic; }
  .iaag__answer[data-state="loading"] :global(p) { margin: 0.7rem 0; }
  .iaag__answer[data-state="error"] {
    border-left-color: #b3261e;
    background: #fbeceb;
  }
  .iaag__disclaimer {
    margin: 1rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { withBase } from "../lib/base";

  document.querySelectorAll<HTMLElement>("[data-iaag]").forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>("[data-iaag-toggle]")!;
    const label = root.querySelector<HTMLElement>("[data-iaag-label]")!;
    const panel = root.querySelector<HTMLElement>("[data-iaag-panel]")!;
    const form = root.querySelector<HTMLFormElement>("[data-iaag-form]")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const send = form.querySelector<HTMLButtonElement>("button")!;
    const answer = root.querySelector<HTMLElement>("[data-iaag-answer]")!;
    const chips = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-iaag-ask]"),
    );

    let conversationId: string | null = null;
    let busy = false;

    // Minimal + safe markdown: escape, then **bold**, `code`, bullets, paragraphs.
    function render(md: string): string {
      const esc = md
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
      const inline = (s: string) =>
        s
          .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
          .replace(/`([^`]+)`/g, "<code>$1</code>");
      return esc
        .split(/\n{2,}/)
        .map((block) => {
          const lines = block.split("\n");
          if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
            return `<ul>${lines
              .map((l) => `<li>${inline(l.replace(/^\s*[-*]\s+/, ""))}</li>`)
              .join("")}</ul>`;
          }
          return `<p>${inline(block).replace(/\n/g, "<br>")}</p>`;
        })
        .join("");
    }

    toggle.addEventListener("click", () => {
      const open = panel.hasAttribute("hidden");
      panel.toggleAttribute("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Close" : "View";
    });

    async function ask(question: string) {
      if (busy || !question.trim()) return;
      busy = true;
      send.disabled = true;
      chips.forEach((c) => (c.disabled = true));
      answer.hidden = false;
      answer.dataset.state = "loading";
      answer.textContent = `Asking about “${question}”…`;

      try {
        const res = await fetch(withBase("api/genie"), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ question, conversationId }),
        });
        if (!res.headers.get("content-type")?.includes("application/json")) {
          // The platform's own gateway can time out and return an HTML error
          // page before our route's slower Genie poll finishes.
          throw new Error(
            "Genie is taking longer than usual to respond. Please try again.",
          );
        }
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status}).`);
        conversationId = data.conversationId ?? conversationId;
        answer.dataset.state = "ok";
        answer.innerHTML = render(data.answer);
      } catch (err) {
        answer.dataset.state = "error";
        answer.textContent =
          err instanceof Error ? err.message : "Something went wrong. Please try again.";
      } finally {
        busy = false;
        send.disabled = false;
        chips.forEach((c) => (c.disabled = false));
      }
    }

    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        input.value = chip.dataset.iaagAsk || "";
        ask(input.value);
      }),
    );

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      ask(input.value);
    });
  });
</script>
