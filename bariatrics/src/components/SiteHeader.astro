---
// Simplified rebuild of the Community Health Network global header.
import SiteSearch from "./SiteSearch.astro";
---
<header class="site-header">
  <div class="topbar"></div>
  <div class="wrap header-inner">
    <a class="brand" href="https://www.ecommunity.com/" aria-label="Community Health Network home">
      <img class="brand__logo" src={`${import.meta.env.BASE_URL}chn-logo.svg`} alt="Community Health Network" width="232" height="56" />
    </a>
    <nav class="header-actions" aria-label="Utility">
      <a href="https://www.ecommunity.com/mychart">MyChart</a>
      <a href="https://www.ecommunity.com/find-a-provider">Find a Provider</a>
      <a class="btn" href="https://www.ecommunity.com/services/community-bariatric-and-medical-weight-loss-services/bariatric-hra">Get Started</a>
      <SiteSearch />
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .topbar {
    height: 6px;
    background: linear-gradient(90deg, #7b3f98 0 55%, #e87722 55% 78%, #2f83b3 78% 100%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .brand__logo {
    display: block;
    height: 40px;
    width: auto;
  }
  @media (max-width: 480px) {
    .brand__logo { height: 32px; }
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  .header-actions a:not(.btn) {
    color: var(--heading);
    text-decoration: none;
    font-weight: 600;
  }
  .header-actions a:not(.btn):hover { color: var(--accent); }
  @media (max-width: 640px) {
    .header-actions a:not(.btn) { display: none; }
  }
</style>
