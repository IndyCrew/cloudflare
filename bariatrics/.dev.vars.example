# Local-only secrets for `npm run dev` / `wrangler dev`. Copy to .dev.vars (gitignored).
# Only the client secret is required; the other IDs default in src/pages/api/genie.ts.
DATABRICKS_CLIENT_SECRET=

# Optional overrides:
# DATABRICKS_TENANT_ID=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_WORKSPACE_URL=
# DATABRICKS_GENIE_SPACE_ID=
# DATABRICKS_GENIE_MODE=CHAT
